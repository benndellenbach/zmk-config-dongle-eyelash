keymap {
        compatible = "zmk,keymap";

        base5_layer {
            display-name = "Base5";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T               &kp UP                  &kp Y  &kp U  &kp I                    &kp O                        &kp P                   &none
&none  &kp A  &kp S  &kp D  &kp F  &kp G    &kp LEFT   &kp ENTER  &kp RIGHT    &kp H  &kp J  &kp K                    &kp L                        &ht_sym COLON SEMI      &none
&none  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp C_PP              &kp DOWN     &kp N  &kp M  &ht_sym LESS_THAN COMMA  &ht_sym GREATER_THAN PERIOD  &ht_sym QUESTION SLASH  &none
                     &lt SYM TAB  &lt MOUSE SPACE  &ht_num_sk NUM LSHFT      &lt FN RETURN  &lt MOUSE SPACE  &back_del
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        full_layer {
            display-name = "Full";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E  &kp R  &kp T               &kp UP                  &kp Y  &kp U  &kp I                    &kp O                        &kp P                   &back_del
&td0              &kp A  &kp S  &kp D  &kp F  &kp G    &kp LEFT   &kp ENTER  &kp RIGHT    &kp H  &kp J  &kp K                    &kp L                        &ht_sym COLON SEMI      &ht_sym DOUBLE_QUOTES APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V  &kp B    &to GAME              &kp DOWN     &kp N  &kp M  &ht_sym LESS_THAN COMMA  &ht_sym GREATER_THAN PERIOD  &ht_sym QUESTION SLASH  &kp ESCAPE
                                &lt SYM DELETE  &lt MOUSE SPACE  &ht_num_sk NUM LSHFT      &lt FN RETURN  &lt MOUSE SPACE  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        colemak_dh_layer {
            display-name = "ColemakDH";
            bindings = <
&none  &kp Q  &kp W  &kp F  &kp P  &kp B               &kp UP                  &kp J  &kp L  &kp U                    &kp Y                        &ht_sym COLON SEMI      &none
&none  &kp A  &kp R  &kp S  &kp T  &kp G    &kp LEFT   &kp ENTER  &kp RIGHT    &kp M  &kp N  &kp E                    &kp I                        &kp O                   &none
&none  &kp Z  &kp X  &kp C  &kp D  &kp V    &kp C_PP              &kp DOWN     &kp K  &kp H  &ht_sym LESS_THAN COMMA  &ht_sym GREATER_THAN PERIOD  &ht_sym QUESTION SLASH  &none
                     &lt SYM TAB  &lt MOUSE SPACE  &ht_num_sk NUM LSHFT      &lt FN RETURN  &lt MOUSE SPACE  &back_del
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        mouse_layer {
            display-name = "mouse";
            bindings = <
&trans  &kp LC(A)  &kp LC(S)  &kp LC(F)  &kp LC(FSLH)  &kp LG(LS(S))                     &msc SCRL_UP                        &kp LC(UP)      &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP     &trans
&trans  &kp LGUI   &kp LALT   &kp LSHFT  &kp LCTRL     &kp LC(D)        &msc SCRL_LEFT   &mkp MCLK        &msc SCRL_RIGHT    &kp LC(DOWN)    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN   &none
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)     &kp LC(Y)        &trans                            &msc SCRL_DOWN     &msc SCRL_LEFT  &kp LC(LEFT)    &mkp MB3        &kp LC(RIGHT)    &msc SCRL_RIGHT  &none
                              &mo PREC  &mkp LCLK  &mkp RCLK      &mkp RCLK  &mkp LCLK  &mo PREC
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        fn_layer {
            display-name = "fn";
            bindings = <
&trans  &kp LC(LS(T))  &kp LC(W)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LC(T)                           &kp PG_UP                           &kp PG_UP   &kp HOME  &kp UP      &kp END     &kp C_VOL_UP  &trans
&trans  &kp LGUI       &kp LALT   &kp LSHFT        &kp LCTRL    &kp LC(LA(TAB))    &kp LC(LS(TAB))  &kp ENTER        &kp LC(TAB)        &kp PG_DN   &kp LEFT  &kp DOWN    &kp RIGHT   &kp C_VOL_DN  &trans
&trans  &kp LG(V)      &kp LC(L)  &kp LC(LS(P))    &kp LC(P)    &kp LC(GRAVE)      &kp C_MUTE                        &kp PG_DN          &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_MUTE  &trans        &trans
                                  &trans  &trans  &trans      &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        gaming_layer {
            display-name = "Game";
            bindings = <
&none  &kp TAB    &kp Q  &kp W  &kp E  &kp R               &kp UP                  &kp Y  &kp U  &kp I      &kp O    &kp P     &none
&none  &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &kp LEFT   &kp ENTER  &kp RIGHT    &kp H  &kp J  &kp K      &kp L    &kp SEMI  &none
&none  &kp LCTRL  &kp Z  &kp X  &kp C  &kp V    &to BASE              &kp DOWN     &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                         &td_gfn  &kp SPACE  &kp G      &kp RET  &kp SPACE  &kp BSPC
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        numpad_layer {
            display-name = "num";
            bindings = <
&trans  &kp GRAVE  &kp F7  &kp F8  &kp F9  &kp F12                &kp UP                    &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT       &kp GRAVE
&trans  &kp APOS   &kp F4  &kp F5  &kp F6  &kp F11    &kp LEFT    &kp ENTER   &kp RIGHT     &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp COLON      &trans
&trans  &trans     &kp F1  &kp F2  &kp F3  &kp F10    &kp C_MUTE              &kp DOWN      &kp MINUS  &kp N1  &kp N2  &kp N3  &kp BACKSLASH  &trans
                           &trans  &trans  &trans      &trans  &kp N0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&trans  &kp GRAVE  &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS  &kp PIPE                 &kp UP                    &kp RS(LBKT)   &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(RBKT)       &kp RS(GRAVE)
&trans  &kp EXCL   &kp EQUAL      &kp PLUS          &kp UNDER  &kp AMPS     &kp LEFT    &kp ENTER   &kp RIGHT     &kp RS(EQUAL)  &kp RS(N4)  &kp RS(N5)  &kp RS(N6)  &kp COLON          &trans
&trans  &kp TILDE  &kp HASH       &kp DOLLAR        &kp PRCNT  &kp CARET    &kp C_MUTE              &kp DOWN      &kp RS(MINUS)  &kp RS(N1)  &kp RS(N2)  &kp RS(N3)  &kp RS(BACKSLASH)  &trans
                                  &trans  &trans  &trans      &trans  &kp RS(N0)  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        system_layer {
            display-name = "System";
            bindings = <
&none  &out OUT_USB  &out OUT_TOG  &out OUT_BLE  &none           &none                         &bt BT_NXT                    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4    &out OUT_USB  &none         &out OUT_BLE    &tog FULL        &tog CDH         &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none
&none  &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &studio_unlock  &to GAME        &none                       &bt BT_PRV      &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &none            &sys_reset       &bootloader      &none
                                   &trans  &trans  &trans      &trans  &trans  &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };

        game_fn_layer {
            display-name = "GameFn";
            bindings = <
&none  &kp N1   &kp N2  &kp N3  &kp N4  &kp N5                  &kp C_VOL_UP                  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5    &none
&none  &kp N6   &kp N7  &kp N8  &kp N9  &kp N0    &kp C_PREV    &kp C_PP      &kp C_NEXT      &kp F6   &kp F7   &kp F8        &kp F9        &kp F10   &none
&none  &kp ESC  &kp T   &kp B   &kp M   &kp I     &trans                      &kp C_VOL_DN    &kp F11  &kp F12  &kp C_VOL_DN  &kp C_VOL_UP  &to BASE  &none
                        &trans  &kp ENTER  &kp LALT      &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        precise_layer {
            display-name = "Precise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans                                  &trans  &trans  &trans
            >;
        };
    };
};
